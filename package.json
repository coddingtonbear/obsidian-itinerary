{
  "name": "obsidian-itinerary",
  "version": "1.3.0",
  "private": true,
  "description": "Make planning your trip or event easier by rendering a calendar from event information found in your notes.",
  "engines": {
    "node": ">=22"
  },
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck && tsc -noEmit -skipLibCheck -p tsconfig.test.json",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint src/",
    "test": "jest"
  },
  "keywords": [],
  "author": "Adam Coddington <me@adamcoddington.net>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "jest": "^30",
    "jest-environment-jsdom": "^30.5.2",
    "obsidian": "^1.13.1",
    "ts-jest": "^29.4.15",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@fullcalendar/core": "~6.1.22",
    "@fullcalendar/daygrid": "~6.1.22",
    "@fullcalendar/list": "~6.1.22",
    "@fullcalendar/luxon3": "~6.1.22",
    "@fullcalendar/timegrid": "~6.1.22",
    "filtrex": "^3.1.0",
    "luxon": "^3.7.2"
  }
}
